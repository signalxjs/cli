/// <reference types="@sigx/vite/client" />
",
    "==> src/styles.css <==
@import "tailwindcss";

/* The starter's component classes, expressed with Tailwind utilities. Replace
   them with utilities in your markup as you go — nothing else depends on them. */
@layer components {
    .app { @apply min-h-screen flex flex-col bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100; }
    .app-header { @apply flex items-center justify-between px-6 py-4 border-b border-slate-200 bg-white dark:bg-slate-900 dark:border-slate-800; }
    .brand { @apply font-bold text-lg; }
    .nav { @apply flex gap-4; }
    .link { @apply text-indigo-600 hover:underline dark:text-indigo-400; }
    .app-main { @apply flex-1 grid place-items-center px-4 py-8; }
    .app-footer { @apply text-center text-sm py-4; }
    .card { @apply w-full max-w-md rounded-2xl border border-slate-200 bg-white shadow-lg dark:bg-slate-900 dark:border-slate-800; }
    .card-body { @apply p-8 text-center; }
    .card-title { @apply text-2xl font-semibold mb-2; }
    .muted { @apply text-slate-500 dark:text-slate-400 mb-6; }
    .counter { @apply flex items-center justify-center gap-4; }
    .btn { @apply cursor-pointer rounded-lg border border-slate-200 bg-white px-4 py-2 transition hover:brightness-95 dark:bg-slate-800 dark:border-slate-700; }
    .btn-primary { @apply bg-indigo-600 text-white border-indigo-600 hover:bg-indigo-700; }
    .btn-ghost { @apply bg-transparent; }
    .badge { @apply inline-block min-w-14 rounded-full bg-indigo-100 px-3 py-1 font-semibold text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300; }
    .badge-lg { @apply text-xl; }
    .prose { @apply max-w-2xl w-full block; }
    .prose h1 { @apply text-3xl font-bold mb-4; }
    .prose p, .prose li { @apply mb-2; }
    .prose ul { @apply list-disc pl-6; }
    code { @apply rounded bg-slate-200 px-1 py-0.5 text-[0.92em] dark:bg-slate-800; }
}
