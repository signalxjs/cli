        title: 'my-app',
        description: 'A SignalX static site',
        url: 'https://example.com',
        favicon: '/favicon.svg',
    },
    // Built-in search index over the rendered pages.
    search: true,
    markdown: {
        shiki: {
            light: 'github-light',
            dark: 'github-dark',
        },
    },
});
",
