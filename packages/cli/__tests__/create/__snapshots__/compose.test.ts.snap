        "noEmit": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "src"
    ]
}
",
  ],
  "layers": [
    "base",
    "terminal",
  ],
}
