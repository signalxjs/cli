import { defineConfig } from 'vite';
import sigx from '@sigx/vite';
import { sigxResume } from '@sigx/vite/resume';
import { sigxServer } from '@sigx/vite/server';
import tailwindcss from '@tailwindcss/vite';
import { cloudflare } from '@sigx/cloudflare';

// Externalized from the dev-server module graph so the app, the request
// handler and the render plugins share one set of @sigx module instances.
const SIGX_FAMILY = ['sigx', '@sigx/server-renderer', '@sigx/runtime-core', '@sigx/runtime-dom', '@sigx/reactivity', '@sigx/resume', '@sigx/server'];

export default defineConfig(({ command }) => ({
    plugins: [
        sigx({ ssr: { entry: 'src/entry-server.tsx', adapter: cloudflare() } }),
        sigxResume(),
        sigxServer({ renderBoundaries: '/src/dev-refresh.ts' }),
        tailwindcss()
    ],
    oxc: {
        jsx: {
            runtime: 'automatic',
            importSource: 'sigx'
        }
    },
    ...(command === 'serve' && {
        ssr: { external: SIGX_FAMILY }
    })
}));
",
    "==> wrangler.jsonc <==
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "my-app",
    "main": "dist/server/entry.cloudflare.js",
    "compatibility_date": "2026-08-01",
    // node:async_hooks carries the request into server functions called during SSR.
    "compatibility_flags": ["nodejs_compat"],
    "assets": {
        "directory": "dist/client",
        // Never serve the raw index.html template — the worker renders the document.
        "html_handling": "none"
    }
}
",
  ],
  "layers": [
    "base",
    "ssr",
    "render:resume",
    "target:cloudflare",
    "styling:tailwind",
  ],
}
`;

