    "==> README.md <==
# my-app

A static site built with \`@sigx/ssg\` — file-based routing, MDX pages, built-in search. Scaffolded by \`npm create @sigx\` (ssg).

## Getting started

\`\`\`sh
pnpm install
pnpm dev
\`\`\`

## Scripts

- \`pnpm build\` — production build
- \`pnpm preview\` — preview the production build

## Project layout

- \`src/pages/\` — every \`.mdx\` or \`.tsx\` file is a route (\`index.mdx\` → \`/\`, \`about.mdx\` → \`/about\`)
- \`src/layouts/default.tsx\` — the page frame
- \`src/styles/global.css\` — global styles (auto-imported by the generated client entry)
- \`ssg.config.ts\` — site metadata, search, markdown options

Interactive components inside MDX hydrate with \`client:*\` directives, e.g. \`<Counter client:load />\`.

## Deploy

The build renders every route to \`dist/\` as static HTML (plus \`sitemap.xml\`, \`robots.txt\` and the search index). Upload \`dist/\` to any static host — Cloudflare Pages, Netlify, Vercel, GitHub Pages, S3.

## Learn more

- [SignalX docs](https://sigx.dev)
- [GitHub](https://github.com/signalxjs)
",
    "==> package.json <==
{
    "name": "my-app",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "sigx dev",
        "build": "sigx build",
        "preview": "sigx preview"
    },
    "dependencies": {
        "sigx": "<core>",
        "@sigx/router": "^0.12.0",
        "@sigx/server-renderer": "<core>",
        "@sigx/ssg": "^0.21.0"
    },
    "devDependencies": {
        "@sigx/cli": "^0.10.0",
        "@sigx/vite": "<core>",
        "typescript": "^5.9.3",
        "vite": "^8.0.12"
    }
}
",
    "==> pnpm-workspace.yaml <==
# pnpm settings for this project (a single-package "workspace").
# Dependencies allowed to run install scripts — pnpm ignores them otherwise
# (and pnpm 11 fails the install). Both spellings: pnpm 11 reads allowBuilds,
# older pnpm 10 reads onlyBuiltDependencies.
allowBuilds:
  esbuild: true
onlyBuiltDependencies:
  - esbuild
",
    "==> public/favicon.svg <==
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect width="64" height="64" rx="14" fill="#1e1b4b"/><path d="M38 10 20 36h12l-6 18 18-26H32z" fill="#a5b4fc"/></svg>
",
    "==> src/components/Counter.tsx <==
import { component } from 'sigx';

/** An island: server-rendered, hydrated in the browser via \`client:load\`. */
export const Counter = component(({ signal }) => {
    const state = signal({ count: 0 });

    return () => (
        <div class="card">
            <div class="card-body">
                <div class="counter">
                    <button class="btn btn-ghost" onClick={() => state.count--} aria-label="Decrement">−</button>
                    <span class="badge badge-primary badge-lg">{state.count}</span>
                    <button class="btn btn-primary" onClick={() => state.count++} aria-label="Increment">+</button>
                </div>
            </div>
        </div>
    );
});
",
    "==> src/env.d.ts <==
/// <reference types="vite/client" />
",
    "==> src/layouts/default.tsx <==
import { component } from 'sigx';
import type { LayoutProps, LayoutSlots } from '@sigx/ssg';
import { Link } from '@sigx/router';

/** The page frame every route renders into. */
export default component<LayoutProps, unknown, LayoutSlots>(({ slots }) => {
    return () => (
        <div class="app">
            <header class="app-header">
                <span class="brand">⚡ my-app</span>
                <nav class="nav">
                    <Link class="link" to="/">Home</Link>
                    <Link class="link" to="/about">About</Link>
                </nav>
            </header>

            <main class="app-main prose">{slots.default?.()}</main>

            <footer class="app-footer muted">Built with @sigx/ssg</footer>
        </div>
    );
});
",
    "==> src/pages/about.mdx <==
---
title: About
description: About this site
---

# About

Built with [@sigx/ssg](https://sigx.dev/ssg/):

- File-based routing — \`src/pages/about.mdx\` is \`/about\`
- MDX: Markdown with components
- Syntax highlighting with Shiki
- Islands: components hydrate only where you add \`client:*\`
- Sitemap, robots and a search index out of the box
",
    "==> src/pages/index.mdx <==
---
title: Home
description: A SignalX static site
---

import { Counter } from '../components/Counter';

# Welcome to my-app

This site is built with **@sigx/ssg** — every file in \`src/pages/\` is a route,
Markdown and JSX mix freely, and interactive components hydrate on demand.

<Counter client:load />

Edit \`src/pages/index.mdx\` and save to see it update.
",
