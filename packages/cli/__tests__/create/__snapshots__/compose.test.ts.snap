{
    "name": "my-app",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node server.mjs",
        "build": "vite build --app",
        "start": "cross-env NODE_ENV=production node --conditions production server.mjs"
    },
    "dependencies": {
        "sigx": "<core>",
        "@sigx/server-renderer": "<core>",
        "express": "^5.2.1"
    },
    "devDependencies": {
        "@sigx/vite": "<core>",
        "@types/express": "^5.0.6",
        "@types/node": "^22.0.0",
        "cross-env": "^10.1.0",
