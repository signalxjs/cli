import sigx from '@sigx/vite';

export default defineConfig({
    plugins: [
        sigx()
    ],
    oxc: {
        jsx: {
            runtime: 'automatic',
            importSource: 'sigx'
        }
    }
});
",
  ],
  "layers": [
    "base",
    "spa",
  ],
}
`;

