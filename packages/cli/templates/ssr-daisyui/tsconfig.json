{
    "compilerOptions": {
        "target": "ESNext",
        "jsx": "react-jsx",
        "jsxImportSource": "sigx",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts", "src/**/*.tsx"]
}
