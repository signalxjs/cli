{
  "name": "sigx-cli-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "SignalX CLI — unified `sigx` binary, `create-sigx` scaffolder, and web project templates",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint packages/cli/src packages/create-sigx/src",
    "lint:fix": "oxlint --fix packages/cli/src packages/create-sigx/src",
    "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules pnpm-lock.yaml",
    "publish:dry": "node scripts/publish.js --dry-run",
    "publish:all": "node scripts/publish.js",
    "publish:beta": "node scripts/publish.js --tag beta",
    "version:set": "node scripts/bump-version.js",
    "version:patch": "node scripts/bump-version.js patch",
    "version:minor": "node scripts/bump-version.js minor",
    "version:major": "node scripts/bump-version.js major",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260511.1",
    "@vitest/coverage-v8": "^4.1.5",
    "oxlint": "^1.47.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  },
  "keywords": [
    "SignalX",
    "sigx",
    "cli",
    "create",
    "scaffold"
  ],
  "author": "Andreas Ekdahl",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/signalxjs/cli.git"
  },
  "homepage": "https://github.com/signalxjs/cli",
  "bugs": {
    "url": "https://github.com/signalxjs/cli/issues"
  }
}
